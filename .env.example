# Keys for the prompt evaluations (npm run eval). Copy this file to .env and
# fill in whichever you have; .env is ignored by git and never committed.
#
# The evals are the only thing that reads this file. The app itself takes its
# keys from Settings, not from here, so a key left out only means the suites
# judge fewer models.

# Hosted models to judge with. With neither of these set, the suites run
# against whatever Ollama is serving locally.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# An Ollama somewhere other than the usual port.
# CH_LOCAL_URL=http://127.0.0.1:11434/v1

# Where the search suite keeps its index between runs.
# CH_EVAL_DATA=.eval-data

# Which sophistication levels to judge, when no --model is named (see
# src/llm/sophistication.ts). One model is chosen per provider per level.
#   2  mid-size local models, small hosted models (haiku, mini)
#   3  large local models, mid-tier hosted models (sonnet)
#   4  top general-purpose hosted models (opus)
# The default is 2,3,4. The classifier runs in production on the cheapest
# model there is, so judge that suite with CH_EVAL_LEVELS=1,2,3,4 to keep a
# small local model in the comparison.
# CH_EVAL_LEVELS=2,3,4
